# Production environment for docker compose. Generate real secrets with:
# docker run --rm -v "$PWD:/workspace" -w /workspace node:24-alpine node deploy/init-env.mjs
# Never commit .env. Frontend build arguments must never contain secrets.
MONGO_ROOT_PASSWORD=replace-with-random-hex-password
JWT_SECRET=replace-with-random-jwt-secret
ADMIN_EMAIL=admin@businessexperts.asia
ADMIN_PASSWORD=replace-with-strong-admin-password

# Already-live deployment: REQUIRED, copy the exact current live connection privately.
# Only an intentional fresh installation may leave this blank to use be-mongo.
MONGODB_URI=
# Optional BusinessAI super administrator; set BOTH fields to create an account.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Required to deliver verification codes for public enquiry forms.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_BRAND_NAME=Business Experts

# Optional AI provider; blank uses the built-in mentor fallback.
GEMINI_API_KEY=
# Optional remote uploads; blank uses persistent backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional frontend public client ID, never a client secret.
VITE_GOOGLE_CLIENT_ID=
# Shared reverse proxy only; leave blank for the default mode-specific network.
EDGE_NETWORK_NAME=
