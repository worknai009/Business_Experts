# Shared mode: import this file and connect Caddy to the edge network.
(be_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	encode zstd gzip
	request_body {
		max_size 25MB
	}
}

(be_api_routes) {
	@backend path /api /api/* /ai-api /ai-api/*
	handle @backend {
		reverse_proxy be-backend:5000
	}
}

businessexperts.asia {
	import be_headers
	import be_api_routes
	handle {
		reverse_proxy be-frontend:80
	}
}

admin.businessexperts.asia {
	import be_headers
	import be_api_routes
	handle {
		reverse_proxy be-admin:80
	}
}

analytics.businessexperts.asia {
	import be_headers
	import be_api_routes
	handle {
		reverse_proxy be-analytics:80
	}
}

api.businessexperts.asia {
	import be_headers
	reverse_proxy be-backend:5000
}
